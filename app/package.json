{
  "name": "mozhi-reader",
  "productName": "墨纸 Mozhi Reader",
  "version": "0.2.0",
  "description": "墨纸 · 本地藏书与订阅阅读器",
  "main": "out/main/index.js",
  "author": "mozhi",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "dist": "node scripts/dist.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "build": {
    "appId": "com.mozhi.reader",
    "productName": "墨纸 Mozhi Reader",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "resources/**"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "墨纸 Mozhi Reader"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@mozilla/readability": "^0.6.0",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.12.0",
    "iconv-lite": "^0.7.3",
    "linkedom": "^0.18.15",
    "marked": "^18.2.0",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@types/adm-zip": "^0.6.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "s3rver": "^3.7.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
